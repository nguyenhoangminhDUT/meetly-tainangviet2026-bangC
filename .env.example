# 1. OpenRouter API Key (Official for submission)
OPENROUTER_API_KEY=
# OpenRouter Free Models: meta-llama/llama-3.1-8b-instruct:free, google/gemma-2-9b-it:free, qwen/qwen-2.5-coder-32b-instruct:free
# OpenRouter Official Model: qwen/qwen3.7-flash
MODEL_ID=

# 2. Groq API Key (100% Free, ultra-fast dev/test, no credit card: https://console.groq.com/keys)
GROQ_API_KEY=
# Groq Models (<= 27B): llama-3.1-8b-instant, gemma2-9b-it
GROQ_MODEL_ID=llama-3.1-8b-instant

# 3. Google Gemini API Key (100% Free via Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Gemini Models: gemini-1.5-flash, gemini-2.0-flash
GEMINI_MODEL_ID=gemini-1.5-flash

# 4. Local Ollama (100% Offline Free, runs on local GPU RTX 5050)
OLLAMA_URL=http://localhost:11434/v1/chat/completions
OLLAMA_MODEL_ID=qwen2.5-coder:7b
